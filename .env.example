# Copy this file to .env and adjust values before running docker compose up.
# Nothing here needs an internet connection or an external account —
# every value is used only between containers on your own machine.

# --- Database ---
POSTGRES_USER=launchpad
POSTGRES_PASSWORD=launchpad_dev_password
POSTGRES_DB=launchpad

# --- Auth ---
# Generate a real random value before any real deployment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_this_in_production

# --- General ---
ENVIRONMENT=development

# Change this once if 8080 is already taken on your machine, instead of
# editing docker-compose.yml or passing flags every time.
HOST_PORT=8080

# --- Webhooks ---
# Webhooks to private/loopback addresses are refused (SSRF protection).
# Set true ONLY to test against a receiver on your own machine.
WEBHOOK_ALLOW_PRIVATE=false

# --- Public address ---
# Where links in emails and certificate QR codes point. Set this to your
# public URL when you deploy (e.g. https://launchpad.example.com).
PUBLIC_BASE_URL=http://localhost:8080
PLATFORM_NAME=Launchpad

# --- Email notifications ---
# Pick ONE provider. Until it's configured, emails are recorded in the
# organizer's Notifications tab as "skipped: not configured" (you can press
# Retry once it's set up). Demo/fixture accounts (@launchpad.example,
# @example.org, ...) are NEVER emailed, whatever you set here.
#
# Option 1 -- SendGrid API (recommended):
#   1. Create an API key with "Mail Send" permission in SendGrid.
#   2. Verify a sender (Settings -> Sender Authentication -> Single Sender,
#      or authenticate a whole domain). MAIL_FROM must use that address.
MAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
MAIL_FROM=Launchpad <you@yourdomain.com>
#
# Option 2 -- any SMTP server. Set MAIL_PROVIDER=smtp and fill these in.
#   Gmail:          SMTP_HOST=smtp.gmail.com, port 587, STARTTLS true,
#                   username = your Gmail, password = a Google App Password,
#                   MAIL_FROM = that same Gmail address.
#   SendGrid SMTP:  SMTP_HOST=smtp.sendgrid.net, port 587, STARTTLS true,
#                   username = the literal word apikey, password = your API key.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
#
# Extra domains you never want emailed (comma-separated). Optional.
MAIL_SKIP_DOMAINS=

# --- Code check (duplicate code + repository timeline) ---
# Optional but recommended. Without it GitHub allows ~60 API calls/hour
# (~15 repositories). Create one at github.com/settings/tokens with NO
# scopes ticked; it only reads public repositories.
GITHUB_TOKEN=

# --- Production (set automatically by deploy/setup-server.sh) ---
# Your public domain; Caddy gets a free HTTPS certificate for it.
# DOMAIN=launchpad.yourdomain.xyz
# On a server, keep plain-HTTP nginx reachable only from the server itself:
# HOST_PORT=127.0.0.1:8080
